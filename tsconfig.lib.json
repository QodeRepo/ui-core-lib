{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Library emit mode */
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "declaration": true,
        "declarationDir": "./dist",
        "emitDeclarationOnly": true,
        "jsx": "react-jsx",
        "outDir": "./dist",
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/main.tsx",
        "src/App.tsx",
        "src/**/*.stories.*",
        "src/**/*.test.*",
        "src/**/*.spec.*"
    ]
}